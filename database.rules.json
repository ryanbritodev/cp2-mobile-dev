{
  "rules": {
    ".read": false,
    ".write": false,

    "messages": {
      "$conversationId": {
        ".read": "auth != null && (root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true || ($conversationId.matches(/^[A-Za-z0-9]+_[A-Za-z0-9]+$/) && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))))",
        ".indexOn": ["createdAt"],

        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.exists() && (root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true || ($conversationId.matches(/^[A-Za-z0-9]+_[A-Za-z0-9]+$/) && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))))",
          ".validate": "newData.hasChildren(['conversationId', 'conversationType', 'senderId', 'text', 'target', 'createdAt'])",

          "conversationId": { ".validate": "newData.val() === $conversationId" },
          "conversationType": {
            ".validate": "(newData.val() === 'direct' && $conversationId.contains('_')) || (newData.val() === 'group' && !$conversationId.contains('_'))"
          },
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "target": {
            ".validate": "newData.child('type').val() === 'conversation' || (newData.child('type').val() === 'member' && newData.hasChild('memberId'))",
            "type": { ".validate": "newData.val() === 'conversation' || newData.val() === 'member'" },
            "memberId": {
              ".validate": "newData.isString() && newData.val() !== auth.uid && root.child('conversationMembers').child($conversationId).child(newData.val()).val() === true"
            },
            "$other": { ".validate": false }
          },
          "mentionedUserIds": {
            "$index": {
              ".validate": "newData.isString() && newData.val() !== auth.uid && root.child('conversationMembers').child($conversationId).child(newData.val()).val() === true"
            }
          },
          "createdAt": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "lastMessages": {
      "$conversationId": {
        ".read": "auth != null && (root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true || ($conversationId.matches(/^[A-Za-z0-9]+_[A-Za-z0-9]+$/) && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))))",
        ".write": "auth != null && newData.exists() && (root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true || ($conversationId.matches(/^[A-Za-z0-9]+_[A-Za-z0-9]+$/) && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))))",
        ".validate": "newData.hasChildren(['messageId', 'senderId', 'text', 'createdAt'])",
        "messageId": {
          ".validate": "newData.isString() && newData.parent().parent().parent().child('messages').child($conversationId).child(newData.val()).child('senderId').val() === auth.uid"
        },
        "senderId": { ".validate": "newData.val() === auth.uid" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "createdAt": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "conversationMembers": {
      "$conversationId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    }
  }
}
