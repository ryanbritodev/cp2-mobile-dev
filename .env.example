# URL pública (HTTPS) da API de notificações — sem barra no final
EXPO_PUBLIC_API_URL=https://sua-api.onrender.com

# ID do projeto EAS (necessário para o token Expo usado no iOS)
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Opcional: identificadores nativos do app
APP_ANDROID_PACKAGE=br.com.fiap.chatfirebase
APP_IOS_BUNDLE_ID=br.com.fiap.chatfirebase
